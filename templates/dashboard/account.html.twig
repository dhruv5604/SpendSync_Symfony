{% extends 'base.html.twig' %}

{% block title %}Account Management | SpendSync{% endblock %}

{% block body %}
<div class="container">
    <h2 class="mb-4">Manage Accounts</h2>

    {# Flash Messages #}
    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('error') %}
        <div class="alert alert-danger">{{ flash }}</div>
    {% endfor %}

    {# Breadcrumb and Add Button #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">Account</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Accounts</li>
            </ol>
        </nav>
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <a href="{{ path('app_add_account') }}" class="btn btn-primary">Add Account</a>
        {% endif %}
    </div>

    {# Export + Search #}
    <div class="row mb-4">
        <div class="col-md-8 d-flex gap-2">
            <a href="#" class="btn btn-outline-info">Export EXCEL</a>
            <a href="#" class="btn btn-outline-info">Export CSV</a>
            <a href="#" class="btn btn-outline-info">Export PDF</a>
        </div>
        <div class="col-md-4">
            <form role="search" action="{{ path('app_account') }}">
                <input type="text" class="form-control" id="searchField" name="q" placeholder="Search...">
            </form>
        </div>
    </div>

    {# Accounts Table #}
    <div class="card">
        <div class="card-header bg-secondary text-white">Your Accounts</div>
        <div class="card-body">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Total Balance</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for account in accounts %}
                        <tr>
                            <td>{{ account.name }}</td>
                            <td>{{ account.balance }}</td>
                            <td>
                                <a href="{{ path('app_edit_account', {'id': account.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                                <a href="{{ path('app_delete_account', {'id': account.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">No Account Found...</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="pagination justify-content-start mt-4">
                {{ pagerfanta(accounts, 'twitter_bootstrap5') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
