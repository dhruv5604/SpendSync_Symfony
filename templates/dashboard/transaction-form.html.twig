{% extends 'base.html.twig' %} {% block stylesheets %}
{{ parent() }}
<link
  href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css"
  rel="stylesheet"
/>
{% endblock %} {% block body %}
<div class="container mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      {% if type == "expense" %}
      <li class="breadcrumb-item">
        <a href="{{ path('app_expense') }}">Expenses</a>
      </li>
      <li class="breadcrumb-item active" aria-current="page">Add Expenses</li>
      {% elseif type == "income" %}
      <li class="breadcrumb-item">
        <a href="{{ path('app_income') }}">Income</a>
      </li>
      <li class="breadcrumb-item active" aria-current="page">Add Income</li>
      {% endif %}
    </ol>
  </nav>

  <div class="card">
    <div class="card-body">
      <h3>{{ formTitle }}</h3>
      {{ form_start(form) }}
      {{ form_row(form.amount) }}
      {{ form_row(form.category) }}
      {{ form_row(form.account) }}
      {{ form_row(form.description) }}
      {{ form_row(form.transaction_date) }}
      {{ form_row(form.splitWithFriends) }}
      <div id="split-amounts-wrapper" class="mt-3"></div>
      <button type="submit" class="btn btn-primary">Add Expense</button>
      {{ form_end(form) }}
    </div>
  </div>
</div>

{% endblock %} 

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
<script>
  function initTransactionForm() {
  $('.select2').select2({
    placeholder: "Select friends (optional)",
    allowClear: true,
    width: "100%"
  });

  $('#transaction_type_form_splitWithFriends').on('change.select2', function (e) {
    const amountWrapper = document.getElementById('split-amounts-wrapper');
    amountWrapper.innerHTML = '';

    const selectedOptions = $(this).select2('data');

    selectedOptions.forEach((option, index) => {
      const label = document.createElement('label');
      label.textContent = `Amount for ${option.text}`;
      label.setAttribute('for', `splitAmount${index}`);

      const input = document.createElement('input');
      input.type = 'number';
      input.name = `splitAmounts[${index}]`;
      input.id = `splitAmount${index}`;
      input.className = 'form-control mb-2';
      input.required = true;

      amountWrapper.appendChild(label);
      amountWrapper.appendChild(input);
    });
  });
}
  
document.addEventListener('DOMContentLoaded', initTransactionForm);
document.addEventListener('turbo:load', initTransactionForm);

</script>

{% endblock %}

