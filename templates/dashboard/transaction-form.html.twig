{% extends 'base.html.twig' %}

{% block body %}
<div class="container">

  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
    {% if type == "expense" %}
      <li class="breadcrumb-item"><a href="{{ path('app_expense') }}">Expenses</a></li>
      <li class="breadcrumb-item active" aria-current="page">Add Expenses</li>
    {% elseif type == "income" %}
      <li class="breadcrumb-item"><a href="{{ path('app_income') }}">Income</a></li>
      <li class="breadcrumb-item active" aria-current="page">Add Income</li>
    {% endif %}
    </ol>
  </nav>  

  <div class="card">
    <div class="card-body">
      <h3>{{ formTitle }}</h3>
      {{ form_start(form) }}
        {{ form_row(form.amount) }}
        {{ form_row(form.category) }}
        {{ form_row(form.account) }}
        {{ form_row(form.description) }}
        {{ form_row(form.transaction_date) }}
        <button type="submit" class="btn btn-primary">Add Expense</button>
      {{ form_end(form) }}

    </div>
  </div>

</div>
{% endblock %}
