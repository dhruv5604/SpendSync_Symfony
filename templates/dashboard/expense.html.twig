{% extends 'base.html.twig' %}

{% block title %}Expense Management | SpendSync{% endblock %}

{% block body %}
<div class="container">
    <h2 class="mb-4">Manage Expenses</h2>

    {# Flash Messages #}
    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('error') %}
        <div class="alert alert-danger">{{ flash }}</div>
    {% endfor %}

    {# Top Bar (Breadcrumb + Add Button) #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_expense') }}">Expenses</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Expenses</li>
            </ol>
        </nav>
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <a href="{{ path('app_add_expense') }}" class="btn btn-primary">Add Expense</a>
        {% endif %}
    </div>

    {# Export & Search Row #}
    <div class="row mb-4">
        <div class="col-md-8 d-flex gap-2">
            <a href="#" class="btn btn-outline-info">Export EXCEL</a>
            <a href="#" class="btn btn-outline-info">Export CSV</a>
            <a href="#" class="btn btn-outline-info">Export PDF</a>
        </div>
        <div class="col-md-4">
            <form role="search" action="{{ path('app_expense') }}">
                <input type="text" class="form-control" id="searchField" name="q" placeholder="Search...">
            </form>
        </div>
    </div>

    {# Expenses List Card #}
    <div class="card">
        <div class="card-header bg-secondary text-white">
            Your Expenses
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Account</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for expense in expenses %}
                        <tr>
                            <td>{{ expense.amount }}</td>
                            <td>{{ expense.category }}</td>
                            <td>{{ expense.description }}</td>
                            <td>{{ expense.account.name }}</td>
                            <td>{{ expense.transactiondate|date('d-m-Y') }}</td>
                            <td>
                                <a href="{{ path('app_edit_expense', { 'id': expense.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                                <a href="{{ path('app_delete_expense', { 'id': expense.id }) }}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this expense?')">Delete</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-muted text-center">No expenses found...</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# Pagination #}
            <div class="pagination justify-content-start mt-4">
                {{ pagerfanta(expenses, 'twitter_bootstrap5') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
