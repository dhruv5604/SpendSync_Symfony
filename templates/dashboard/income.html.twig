{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-9">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="">Incomes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">My Incomes</li>
                </ol>
            </nav>
        </div>

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <div class="col-md-2">
            <a href="{{ path('app_add_income') }}" class="btn btn-primary">Add Income</a>
        </div>
    </div>
    <br>
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <a href="#" class="btn btn-info">Export EXCEL</a>
                <a href="#" class="btn btn-info">Export CSV</a>
            </div>
            <div class="col-md-4">
                {# <a href="{% url " export-pdf" %}" class="btn btn-info">Export PDF</a> #}
                <input type="text" class="form-control" id="searchField" placeholder="search">
            </div>
        </div>
        <br>

        {% for flash in app.flashes('success') %}
            <div class="alert alert-success">{{ flash }}</div>
        {% endfor %}

        <div class="app-table">
            <table class="table table-stripped table-hover">
                <thead>
                    <tr>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    {% for income in incomes %}
                        <tr>
                            <td>{{ income.Amount }}</td>
                            <td>{{ income.Category }}</td>
                            <td>{{ income.description }}</td>
                            <td>{{ income.incomeDate|date('d-m-Y') }}</td>
                            <td>
                                <a href="{{ path('app_edit_income',{'id': income.id}) }}" class="btn btn-secondary">Edit</a>
                                <a href="{{ path('app_delete_income',{'id': income.id}) }}" class="btn btn-secondary">Delete</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>No Incomes Found...</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="pagination justify-content-left mt-4">
                {{ pagerfanta(incomes, 'twitter_bootstrap5') }}
            </div>
        </div>
    </div>
    {% else %}
        <div class="row">
            You need to login first
        </div>
    {% endif %}
</div>


{# <script src="{% static ' js/searchincomes.js' %}"></script> #}
{% endblock %}