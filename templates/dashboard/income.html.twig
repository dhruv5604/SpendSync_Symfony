{% extends 'base.html.twig' %}

{% block title %}Income Management | SpendSync{% endblock %}

{% block body %}
<div class="container">
    <h2 class="mb-4">Manage Incomes</h2>

    {# Flash Messages #}
    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}

    {# Breadcrumb and Add Button #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">Income</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Incomes</li>
            </ol>
        </nav>
        <a href="{{ path('app_add_income') }}" class="btn btn-primary">Add Income</a>
    </div>

    {# Export + Search #}
    <div class="row mb-4">
        <div class="col-md-8 d-flex gap-2">
            <a href="#" class="btn btn-outline-info">Export EXCEL</a>
            <a href="#" class="btn btn-outline-info">Export CSV</a>
            <a href="#" class="btn btn-outline-info">Export PDF</a>
        </div>
        <div class="col-md-4">
            <form role="search" action="{{ path('app_income') }}">
                <input type="text" class="form-control" id="searchField" name="q" placeholder="Search...">
            </form>
        </div>
    </div>

    {# Income Table #}
    <div class="card">
        <div class="card-header bg-secondary text-white">Your Incomes</div>
        <div class="card-body">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                       <th>Amount</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Account</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for income in incomes %}
                        <tr>
                            <td>{{ income.amount }}</td>
                            <td>{{ income.category }}</td>
                            <td>{{ income.description }}</td>
                            <td>{{ income.account.name }}</td>
                            <td>{{ income.transactiondate|date('d-m-Y') }}</td>
                            <td>
                                <a href="{{ path('app_edit_income', {'id': income.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                                <a href="{{ path('app_delete_income', {'id': income.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Delete this income?')">Delete</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">No Incomes Found...</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="pagination justify-content-start mt-4">
                {{ pagerfanta(incomes, 'twitter_bootstrap5') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
